# Copy to .env and adjust

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=secretary
POSTGRES_USER=secretary
POSTGRES_PASSWORD=secretary

API_HOST=0.0.0.0
API_PORT=8000

# Host bind for API port mapping (host:container). VDS example: 127.0.0.1:18080
SECRETARY_API_BIND=0.0.0.0:8000

# OpenAI — put the real key only in .env (never commit .env)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MODEL=gpt-5.6-terra
OPENAI_ASSISTANT_MODEL=gpt-5.6-luna
OPENAI_ASSISTANT_REASONING_EFFORT=low
OPENAI_ASSISTANT_VERBOSITY=low
OPENAI_ASSISTANT_MAX_OUTPUT_TOKENS=1600
OPENAI_ALLOWED_ASSISTANT_MODELS=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
SECRETARY_TIMEZONE=Europe/Amsterdam

# MCP Streamable HTTP at /mcp — keep false until public HTTPS/auth exists
MCP_ENABLED=false

# Fernet key for encrypted OAuth tokens — generate on VDS only; never commit real value
SECRETARY_CREDENTIAL_KEY=

# Mattermost read-only connector — comma-separated HTTPS base URLs; empty disables connect
MATTERMOST_ALLOWED_BASE_URLS=
MATTERMOST_SYNC_DAYS=14
MATTERMOST_SYNC_MAX_CHANNELS=50
MATTERMOST_SYNC_INITIAL_POSTS_PER_CHANNEL=100
MATTERMOST_SYNC_MAX_POSTS_PER_RUN=500
MATTERMOST_SYNC_OVERLAP_SECONDS=300
SOURCE_SYNC_MATTERMOST_INTERVAL_SECONDS=120
SOURCE_SYNC_USER_MIN_INTERVAL_SECONDS=60
SOURCE_SYNC_USER_MAX_INTERVAL_SECONDS=86400
SOURCE_SYNC_USER_MIN_HISTORY_DAYS=1
SOURCE_SYNC_USER_MAX_HISTORY_DAYS=90

# Telegram Bot API + Secretary Mode. Empty keeps Telegram unavailable; never commit real secrets.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
# Telegram MTProto user authorization — empty keeps personal account unavailable; never commit real secrets.
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
SOURCE_SYNC_TELEGRAM_MTPROTO_INTERVAL_SECONDS=60

# Microsoft Teams delegated OAuth (work/school only). Empty keeps Teams unavailable; never commit real secrets.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:18080/auth/teams/callback
MICROSOFT_TEAMS_NOTIFICATION_URL=
SOURCE_SYNC_TEAMS_INTERVAL_SECONDS=900

# Google OAuth client JSON is mounted read-only; do not put client_id/secret here
GOOGLE_OAUTH_CLIENT_FILE=/run/secrets/google-oauth-client.json
GOOGLE_REDIRECT_URI=http://localhost:18080/auth/google/callback
